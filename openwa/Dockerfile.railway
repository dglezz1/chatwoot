# OpenWA Dockerfile for Railway
#
# This is a single-stage build (not multi-stage) optimized for Railway
# where build happens once and the resulting image runs. The original
# OpenWA Dockerfile is multi-stage with --platform=$BUILDPLATFORM which
# Railway doesn't need (Railway builds natively for the deploy target).
#
# Build context: this directory (openwa/)

FROM node:22-slim

ENV NODE_ENV=production \
    APP_DIR=/app \
    WA_EXECUTABLE_PATH=/usr/bin/google-chrome \
    WA_USE_CHROME=true \
    WA_DISABLE_SPINS=true \
    WA_POPUP=true

RUN apt-get update && apt-get install -y --no-install-recommends \
      chromium fonts-liberation libnss3 libatk1.0-0 libatk-bridge2.0-0 \
      libdrm2 libxkbcommon0 libxcomposite1 libxdamage1 libxfixes3 libxrandr2 \
      libgbm1 libpango-1.0-0 libcairo2 libasound2 dumb-init ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

WORKDIR $APP_DIR

COPY package*.json ./
RUN npm ci --omit=dev

COPY . .

RUN npm run build

# OpenWA seeds an admin API key on first run and writes it to /app/data/.api-key
# Persist that directory as a Railway volume.
RUN mkdir -p /app/data/sessions /app/data/media /app/data/plugins /app/data/engine

# Defaults — Railway will override these via service variables.
ENV API_KEY=dev-admin-key \
    PORT=2785

EXPOSE 2785

# dumb-init for clean SIGTERM (Railway shutdown); gosu drops to non-root.
# The official entrypoint fixes volume perms and execs `node dist/main`.
COPY --chown=root:root docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

USER root
ENTRYPOINT ["/usr/bin/dumb-init", "--", "/usr/local/bin/docker-entrypoint.sh"]
CMD ["node", "dist/main"]
