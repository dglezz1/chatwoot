# OpenWA Dockerfile for Railway (chatwoot-root build context)
#
# Railway provides the entire chatwoot repo as build context. We copy
# what we need from /openwa/ subdir into /app inside the image.

FROM node:22-slim

ENV APP_DIR=/app \
    WA_EXECUTABLE_PATH=/usr/bin/google-chrome \
    WA_USE_CHROME=true \
    WA_DISABLE_SPINS=true \
    WA_POPUP=true

# IMPORTANT: NODE_ENV=production is set LATER (after npm ci + build) because npm skips
# devDependencies when NODE_ENV=production, which would skip @nestjs/cli needed for `nest build`.

RUN apt-get update && apt-get install -y --no-install-recommends \
      chromium fonts-liberation libnss3 libatk1.0-0 libatk-bridge2.0-0 \
      libdrm2 libxkbcommon0 libxcomposite1 libxdamage1 libxfixes3 libxrandr2 \
      libgbm1 libpango-1.0-0 libcairo2 libasound2 dumb-init ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

WORKDIR $APP_DIR

COPY openwa/package.json openwa/package-lock.json ./

# Install ALL deps including dev (@nestjs/cli, typescript) needed for the build.
# NODE_ENV is NOT set to production yet, so dev deps will be installed.
RUN npm ci && npm run build

# Now copy full source (already-built dist/ is preserved) — using .dockerignore exclusions for 
# node_modules, dashboard/, etc.
COPY openwa/ ./

# Persist data dirs as Railway volumes.
RUN mkdir -p /app/data/sessions /app/data/media /app/data/plugins /app/data/engine

# Now switch to production mode and prune dev deps to keep image small.
ENV NODE_ENV=production
RUN npm prune --omit=dev

ENV API_KEY=dev-admin-key \
    PORT=2785

EXPOSE 2785

COPY openwa/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

ENTRYPOINT ["/usr/bin/dumb-init", "--", "/usr/local/bin/docker-entrypoint.sh"]
CMD ["node", "dist/main"]
