# OpenWA Dockerfile for Railway (chatwoot-root build context)
#
# Railway provides the entire chatwoot repo as build context. We copy
# what we need from /openwa/ subdir into /app inside the image.

FROM node:22-slim

ENV APP_DIR=/app \
    WA_EXECUTABLE_PATH=/usr/bin/google-chrome \
    WA_USE_CHROME=true \
    WA_DISABLE_SPINS=true \
    WA_POPUP=true

RUN apt-get update && apt-get install -y --no-install-recommends \
      chromium fonts-liberation libnss3 libatk1.0-0 libatk-bridge2.0-0 \
      libdrm2 libxkbcommon0 libxcomposite1 libxdamage1 libxfixes3 libxrandr2 \
      libgbm1 libpango-1.0-0 libcairo2 libasound2 dumb-init ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

WORKDIR $APP_DIR

# Copy config files needed for build + install all deps (including dev: @nestjs/cli, typescript).
COPY openwa/package.json openwa/package-lock.json openwa/tsconfig.json openwa/tsconfig.build.json openwa/nest-cli.json ./

# NODE_ENV is not yet production, so dev deps install correctly.
RUN npm ci && npm run build

# Now copy source + everything else. Already-built dist/ is preserved.
COPY openwa/ ./

# Persist data dirs as Railway volumes.
RUN mkdir -p /app/data/sessions /app/data/media /app/data/plugins /app/data/engine

# Switch to production mode and prune dev deps to keep image small.
ENV NODE_ENV=production
RUN npm prune --omit=dev

ENV API_KEY=dev-admin-key \
    PORT=2785

EXPOSE 2785

COPY openwa/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

ENTRYPOINT ["/usr/bin/dumb-init", "--", "/usr/local/bin/docker-entrypoint.sh"]
CMD ["node", "dist/main"]
