# OpenWA Dockerfile for Railway (chatwoot-root build context)
#
# Railway provides the entire chatwoot repo as build context. We copy
# what we need from /openwa/ subdir into /app inside the image.
#
# This file is referenced as `dockerfilePath = "openwa/Dockerfile.railway"`
# with `source.rootDirectory = null` (i.e. context = chatwoot repo root).

FROM node:22-slim

ENV NODE_ENV=production \
    APP_DIR=/app \
    WA_EXECUTABLE_PATH=/usr/bin/google-chrome \
    WA_USE_CHROME=true \
    WA_DISABLE_SPINS=true \
    WA_POPUP=true

RUN apt-get update && apt-get install -y --no-install-recommends \
      chromium fonts-liberation libnss3 libatk1.0-0 libatk-bridge2.0-0 \
      libdrm2 libxkbcommon0 libxcomposite1 libxdamage1 libxfixes3 libxrandr2 \
      libgbm1 libpango-1.0-0 libcairo2 libasound2 dumb-init ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

WORKDIR $APP_DIR

# Copy only the openwa/ subdir contents from the chatwoot build context.
COPY openwa/package.json openwa/package-lock.json ./
RUN npm ci --omit=dev

COPY openwa/ ./

# OpenWA seeds an admin API key on first run; persist the data dir as a Railway volume.
RUN mkdir -p /app/data/sessions /app/data/media /app/data/plugins /app/data/engine

# Build the TypeScript source after npm ci (so node_modules is present for the build).
RUN npm run build

# Defaults — Railway will override these via service variables.
ENV API_KEY=dev-admin-key \
    PORT=2785

EXPOSE 2785

# dumb-init for clean SIGTERM (Railway shutdown); the official entrypoint fixes
# volume perms and execs `node dist/main`.
COPY openwa/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

ENTRYPOINT ["/usr/bin/dumb-init", "--", "/usr/local/bin/docker-entrypoint.sh"]
CMD ["node", "dist/main"]
