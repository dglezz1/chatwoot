# OpenWA Dockerfile for Railway (chatwoot-root build context)
#
# Railway provides the entire chatwoot repo as build context. We copy
# what we need from /openwa/ subdir into /app inside the image.

FROM node:22-slim

ENV NODE_ENV=production \
    APP_DIR=/app \
    WA_EXECUTABLE_PATH=/usr/bin/google-chrome \
    WA_USE_CHROME=true \
    WA_DISABLE_SPINS=true \
    WA_POPUP=true

RUN apt-get update && apt-get install -y --no-install-recommends \
      chromium fonts-liberation libnss3 libatk1.0-0 libatk-bridge2.0-0 \
      libdrm2 libxkbcommon0 libxcomposite1 libxdamage1 libxfixes3 libxrandr2 \
      libgbm1 libpango-1.0-0 libcairo2 libasound2 dumb-init ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

WORKDIR $APP_DIR

# Install ALL deps (including dev: @nestjs/cli, typescript) for the build step.
# After build, prune to prod-only to keep image small.
COPY openwa/package.json openwa/package-lock.json ./
RUN npm ci && npm run build && npm prune --omit=dev

# Copy source + remaining files into /app
COPY openwa/ ./

# Build artifacts in dist/ were generated above; this second npm run build is now a no-op
# but kept for clarity if image is rebuilt without the cached npm ci step.
RUN [ -d dist ] || npm run build

# OpenWA seeds an admin API key; persist the data dir as a Railway volume.
RUN mkdir -p /app/data/sessions /app/data/media /app/data/plugins /app/data/engine

ENV API_KEY=dev-admin-key \
    PORT=2785

EXPOSE 2785

COPY openwa/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

ENTRYPOINT ["/usr/bin/dumb-init", "--", "/usr/local/bin/docker-entrypoint.sh"]
CMD ["node", "dist/main"]
